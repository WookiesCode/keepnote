pkgname=keepnote
pkgver=0.8.0
pkgrel=1
pkgdesc='One persistent note that saves automatically'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/keepnote "$pkgdir/usr/bin/keepnote"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/keepnote.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/keepnote.svg"
  install -Dm644 "$startdir/keepnote.desktop" "$pkgdir/usr/share/applications/keepnote.desktop"
}
